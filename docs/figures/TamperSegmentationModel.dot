digraph TamperSegmentationModel {
  graph [rankdir=LR, splines=true, nodesep=0.9, ranksep=1.3,
         fontname="Helvetica", fontsize=14,
         label="TamperSegmentationModel (ResNet34 backbone) - Corrected", labelloc="t"];
  node  [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge  [penwidth=2];

  // Encoder ---------------------------------------------------------------------
  Input [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#e8f1ff">
      <tr><td><b>Input</b></td></tr>
      <tr><td>B × 3 × 256 × 256</td></tr>
    </table>
  >];

  InputProj [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#f9fcff">
      <tr><td><b>Input projection</b></td></tr>
      <tr><td>Conv3×3, BN, ReLU</td></tr>
      <tr><td>B × 64 × 256 × 256</td></tr>
    </table>
  >];

  Stem [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="8" bgcolor="#f9fcff">
      <tr><td align="center"><b>Stem</b></td></tr>
      <tr><td align="left">
        <table border="0" cellborder="0" cellpadding="4">
          <tr><td align="left" colspan="2">1. <b>Conv7×7 stride2, BN, ReLU</b></td></tr>
          <tr>
            <td width="20"></td>
            <td align="left">
              ↳ <font color="#4a74c1">H/2 features (for skip2)</font><br/>
              &nbsp;&nbsp;&nbsp;<i>B × 64 × 128 × 128</i>
            </td>
          </tr>
          <tr><td align="left" colspan="2"><br/>2. <b>MaxPool</b></td></tr>
          <tr>
            <td width="20"></td>
            <td align="left">
              ↳ <font color="#cc4d4d">H/4 features (main path)</font><br/>
              &nbsp;&nbsp;&nbsp;<i>B × 64 × 64 × 64</i>
            </td>
          </tr>
        </table>
      </td></tr>
    </table>
  >];

  Layer1 [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#f9fcff">
      <tr><td><b>Layer1</b></td></tr>
      <tr><td>ResNet blocks ×3</td></tr>
      <tr><td>B × 64 × 64 × 64</td></tr>
    </table>
  >];

  Layer2 [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#f9fcff">
      <tr><td><b>Layer2</b></td></tr>
      <tr><td>ResNet blocks ×4<br/>stride=2</td></tr>
      <tr><td>B × 128 × 32 × 32</td></tr>
    </table>
  >];

  Layer3 [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#f9fcff">
      <tr><td><b>Layer3</b></td></tr>
      <tr><td>ResNet blocks ×6<br/>stride=2</td></tr>
      <tr><td>B × 256 × 16 × 16</td></tr>
    </table>
  >];

  Layer4 [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#f9fcff">
      <tr><td><b>Layer4</b></td></tr>
      <tr><td>ResNet blocks ×3<br/>stride=2</td></tr>
      <tr><td>B × 512 × 8 × 8</td></tr>
    </table>
  >];

  // Bottleneck Area ----------------------------------------------------
  DeepMerge [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#e2efff">
      <tr><td><b>DeepMerge (in Backbone)</b></td></tr>
      <tr><td>Upsample Layer4 → Reduce<br/><b>Concat [Layer3, up(Layer4)]</b><br/>→ ConvBlock</td></tr>
      <tr><td>B × 256 × 16 × 16</td></tr>
    </table>
  >];

  Bottleneck [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#e2efff">
      <tr><td><b>Bottleneck (in Model)</b></td></tr>
      <tr><td>ConvBlock</td></tr>
      <tr><td>B × 256 × 16 × 16</td></tr>
    </table>
  >];

  // Decoder ---------------------------------------------------------------------
  Dec4 [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#f1f6ff">
      <tr><td><b>DecoderBlock</b> (dec4)</td></tr>
      <tr><td>Upsample → Reduce<br/>Concat skip4 (128 ch) → ConvBlock</td></tr>
      <tr><td>B × 128 × 32 × 32</td></tr>
    </table>
  >];

  Dec3 [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#f1f6ff">
      <tr><td><b>DecoderBlock</b> (dec3)</td></tr>
      <tr><td>Upsample → Reduce<br/>Concat skip3 (64 ch) → ConvBlock</td></tr>
      <tr><td>B × 64 × 64 × 64</td></tr>
    </table>
  >];

  Dec2 [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#f1f6ff">
      <tr><td><b>DecoderBlock</b> (dec2)</td></tr>
      <tr><td>Upsample → Reduce<br/>Concat skip2 (64 ch) → ConvBlock</td></tr>
      <tr><td>B × 64 × 128 × 128</td></tr>
    </table>
  >];

  Dec1 [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#f1f6ff">
      <tr><td><b>DecoderBlock</b> (dec1)</td></tr>
      <tr><td>Upsample → Reduce<br/>Concat skip1 (64 ch) → ConvBlock</td></tr>
      <tr><td>B × 64 × 256 × 256</td></tr>
    </table>
  >];

  Head [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#d1ecff">
      <tr><td><b>Head 1×1 Conv</b></td></tr>
      <tr><td>B × 1 × 256 × 256</td></tr>
    </table>
  >];

  Output [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="6" bgcolor="#e8f1ff">
      <tr><td><b>Tamper logits</b></td></tr>
      <tr><td>B × 1 × 256 × 256</td></tr>
    </table>
  >];

  // EDGES
  // Main encoder path
  edge [color="#cc4d4d"];
  Input -> Stem -> Layer1 -> Layer2 -> Layer3 -> Layer4;

  // Bottleneck fusion edges
  edge [color="#9932CC"]; // Purple for fusion
  Layer3 -> DeepMerge [constraint=false];
  Layer4 -> DeepMerge;
  DeepMerge -> Bottleneck;

  // Decoder path
  edge [color="#2e8b57"];
  Bottleneck -> Dec4 -> Dec3 -> Dec2 -> Dec1 -> Head -> Output;

  // Skip connections and their origins
  edge [color="#4a74c1", style=dashed];
  Input -> InputProj; // Path to create the skip1 features
  InputProj -> Dec1 [label="skip1", constraint=false];
  
  Stem -> Dec2 [label="skip2 (from H/2 features)", constraint=false];
  Layer1 -> Dec3 [label="skip3", constraint=false];
  Layer2 -> Dec4 [label="skip4", constraint=false];

  // Rank alignment for U shape
  {rank=same; Input; Output}
  {rank=same; InputProj; Dec1; Head}
  {rank=same; Stem; Dec2}
  {rank=same; Layer1; Dec3}
  {rank=same; Layer2; Dec4}
  {rank=same; Layer3; Layer4; DeepMerge; Bottleneck}

  Legend [shape=plaintext, fontsize=10, label=<
    <table border="0" cellborder="0" cellspacing="2" cellpadding="1" align="left">
      <tr><td align="left" colspan="2"><b>Legend</b></td></tr>
      <tr><td BORDER="1" BGCOLOR="#cc4d4d" width="15"></td><td align="left">Encoder (ResNet34) path</td></tr>
      <tr><td BORDER="1" BGCOLOR="#9932CC" width="15"></td><td align="left">Feature fusion path</td></tr>
      <tr><td BORDER="1" BGCOLOR="#2e8b57" width="15"></td><td align="left">Decoder path</td></tr>
      <tr><td BORDER="1" BGCOLOR="#4a74c1" width="15"></td><td align="left">Skip connections</td></tr>
    </table>
  >];
}
